# Electron 앱이 접속할 서버 주소 (빌드 시 앱에 포함됨)
SERVER_URL=https://your-server.up.railway.app

# 서버(Railway)용 — Cloudflare TURN (선택, 미설정 시 공개 STUN/TURN 사용)
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# 서버(Railway)용 — 봄노트 연동 (필수)
LIVE_CLASS_SECRET=          # 봄노트 백엔드와 같은 값 (입장 토큰 검증·사용 시간 보고)
BOMNOTE_API_URL=            # 봄노트 백엔드 주소 (예: https://api.bomnote.com)
